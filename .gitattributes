# Append-only ledgers are DIRECTORIES: one record per file (decision 0022).
# plans/lessons/<id>.json, plans/quickfixes/<id>.json. Distinct files do not
# conflict, so there is nothing to merge and no driver to register — this repo
# depends on no custom merge driver at all.
#
# The .jsonl files below are the legacy form, still read so history survives
# and no repo is forced to migrate. `union` is git's BUILT-IN driver and the
# only thing keeping them mergeable while they last; it reorders and can
# DUPLICATE records, which is the behaviour 0022 removes rather than manages.
.gstack/**/*.jsonl merge=union
plans/lessons.jsonl merge=union
plans/quickfixes.jsonl merge=union
# Worker signals remain one task-scoped legacy ledger.
.factory/signals.jsonl merge=union
.factory/history/**/*.jsonl merge=union

# Git Bash executes this launcher on every platform; CRLF breaks POSIX parsing.
forge text eol=lf

# The vendored gate surface is hashed into constitution/VENDOR_MANIFEST.json.
# CRLF on a Windows checkout would make every gate file read as vendor-drift
# against a LF Linux CI checkout (project audit / roadmap-gate). Force LF so the
# surface is byte-identical across platforms; compute_hashes also normalises
# CRLF->LF as a backstop. This file ships to clients via scaffold/upgrade.
factory/scripts/** text eol=lf
factory/schemas/** text eol=lf
factory/prompts/** text eol=lf
.claude/settings.json text eol=lf
.codex/hooks.json text eol=lf
