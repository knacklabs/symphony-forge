  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "email"
        ],
        "title": "Account"
      },
      "ApiErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 64,
            "title": "Code"
          },
          "message": {
            "type": "string",
            "maxLength": 300,
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetails"
              },
              {
                "type": "null"
              }
            ]
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "title": "Errorid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "details",
          "errorId"
        ],
        "title": "ApiErrorBody"
      },
      "CredentialsInput": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "CredentialsInput"
      },
      "ErrorDetails": {
        "properties": {
          "fieldErrors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fielderrors"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ErrorDetails"
      },
      "ErrorEnvelope": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": false,
            "title": "Success",
            "default": false
          },
          "data": {
            "type": "null",
            "title": "Data"
          },
          "error": {
            "$ref": "#/components/schemas/ApiErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 128,
            "title": "Field"
          },
          "reason": {
            "type": "string",
            "maxLength": 256,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "reason"
        ],
        "title": "FieldError"
      },
      "ForgotPasswordInput": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ForgotPasswordInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "maxLength": 16,
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "MessageResponse": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 200,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MessageResponse"
      },
      "Project": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time",
            "title": "Createdatutc"
          },
          "updatedAtUtc": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedatutc"
          },
          "createdByAccountId": {
            "type": "string",
            "format": "uuid",
            "title": "Createdbyaccountid"
          },
          "modifiedByAccountId": {
            "type": "string",
            "format": "uuid",
            "title": "Modifiedbyaccountid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "createdAtUtc",
          "updatedAtUtc",
          "createdByAccountId",
          "modifiedByAccountId"
        ],
        "title": "Project"
      },
      "ProjectInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "ProjectInput"
      },
      "ProjectListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array",
            "title": "Items"
          },
          "pagination": {
            "$ref": "#/components/schemas/ProjectPagination"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "pagination"
        ],
        "title": "ProjectListResponse"
