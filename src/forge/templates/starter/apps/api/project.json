{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b apps/api/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/apps/api/dist",
        "{workspaceRoot}/libs/*/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b apps/api/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.test.json"
      }
    }
  },
  "tags": [
    "type:api"
  ]
}
