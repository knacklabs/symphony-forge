model Account {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email               String   @unique
  passwordHash        String
  createdAtUtc        DateTime @default(now())
  updatedAtUtc        DateTime @updatedAt
  createdByAccountId  String   @db.Uuid
  modifiedByAccountId String   @db.Uuid

  createdByAccount  Account @relation("AccountCreatedBy", fields: [createdByAccountId], references: [id], onDelete: NoAction)
  modifiedByAccount Account @relation("AccountModifiedBy", fields: [modifiedByAccountId], references: [id], onDelete: NoAction)
  accountsCreated   Account[] @relation("AccountCreatedBy")
  accountsModified  Account[] @relation("AccountModifiedBy")
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
  membership        Membership?
  createdProjects   Project[] @relation("ProjectCreatedBy")
  modifiedProjects  Project[] @relation("ProjectModifiedBy")
  deletedProjects   Project[] @relation("ProjectDeletedBy")

  @@index([createdByAccountId], map: "idx_Account_createdByAccountId")
  @@index([modifiedByAccountId], map: "idx_Account_modifiedByAccountId")
  @@schema("core")
}

model Session {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId           String   @db.Uuid
  tokenHash           String   @unique
  csrfTokenHash       String
  expiresAtUtc        DateTime
  createdAtUtc        DateTime @default(now())
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "idx_Session_accountId")
  @@index([expiresAtUtc], map: "idx_Session_expiresAtUtc")
  @@schema("core")
}

model PasswordResetToken {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId    String   @db.Uuid
  tokenHash    String   @unique
  expiresAtUtc DateTime
  createdAtUtc DateTime @default(now())
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "idx_PasswordResetToken_accountId")
  @@index([expiresAtUtc], map: "idx_PasswordResetToken_expiresAtUtc")
  @@schema("core")
}
