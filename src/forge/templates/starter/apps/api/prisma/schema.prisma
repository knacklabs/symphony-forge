generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  active
  archived
}

model Account {
  id                  String   @id @db.Uuid
  email               String   @unique
  passwordHash        String
  createdAtUtc        DateTime @default(now())
  updatedAtUtc        DateTime @updatedAt
  createdByAccountId  String   @db.Uuid
  modifiedByAccountId String   @db.Uuid

  createdByAccount  Account @relation("AccountCreatedBy", fields: [createdByAccountId], references: [id], onDelete: NoAction)
  modifiedByAccount Account @relation("AccountModifiedBy", fields: [modifiedByAccountId], references: [id], onDelete: NoAction)
  accountsCreated   Account[] @relation("AccountCreatedBy")
  accountsModified  Account[] @relation("AccountModifiedBy")
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
  projects          Project[] @relation("ProjectOwner")
  createdProjects   Project[] @relation("ProjectCreatedBy")
  modifiedProjects  Project[] @relation("ProjectModifiedBy")
  deletedProjects   Project[] @relation("ProjectDeletedBy")

  @@index([createdByAccountId], map: "idx_Account_createdByAccountId")
  @@index([modifiedByAccountId], map: "idx_Account_modifiedByAccountId")
}

model Session {
  id                  String   @id @default(uuid()) @db.Uuid
  accountId           String   @db.Uuid
  tokenHash           String   @unique
  csrfTokenHash       String
  expiresAtUtc        DateTime
  createdAtUtc        DateTime @default(now())
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "idx_Session_accountId")
  @@index([expiresAtUtc], map: "idx_Session_expiresAtUtc")
}

model PasswordResetToken {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @db.Uuid
  tokenHash    String   @unique
  expiresAtUtc DateTime
  createdAtUtc DateTime @default(now())
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "idx_PasswordResetToken_accountId")
  @@index([expiresAtUtc], map: "idx_PasswordResetToken_expiresAtUtc")
}

model Project {
  id                  String        @id @default(uuid()) @db.Uuid
  accountId           String        @db.Uuid
  name                String        @db.VarChar(120)
  status              ProjectStatus @default(active)
  createdAtUtc        DateTime      @default(now())
  updatedAtUtc        DateTime      @updatedAt
  createdByAccountId  String        @db.Uuid
  modifiedByAccountId String        @db.Uuid
  deletedAtUtc        DateTime?
  deletedByAccountId  String?       @db.Uuid

  account             Account  @relation("ProjectOwner", fields: [accountId], references: [id], onDelete: Restrict)
  createdByAccount    Account  @relation("ProjectCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  modifiedByAccount   Account  @relation("ProjectModifiedBy", fields: [modifiedByAccountId], references: [id], onDelete: Restrict)
  deletedByAccount    Account? @relation("ProjectDeletedBy", fields: [deletedByAccountId], references: [id], onDelete: Restrict)

  @@index([accountId], map: "idx_Project_accountId")
  @@index([createdByAccountId], map: "idx_Project_createdByAccountId")
  @@index([modifiedByAccountId], map: "idx_Project_modifiedByAccountId")
  @@index([deletedByAccountId], map: "idx_Project_deletedByAccountId")
}
