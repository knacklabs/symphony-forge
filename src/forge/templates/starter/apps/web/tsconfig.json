{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "vite/client",
      "react",
      "node"
    ],
    "noEmit": true,
    "composite": false
  },
  "include": [
    "src",
    "../../libs/*/web/src/**/*",
    "../../libs/shared/ui/src/**/*",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "references": []
}
