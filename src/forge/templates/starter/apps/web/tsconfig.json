{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "vite/client",
      "react",
      "node"
    ],
    "noEmit": true,
    "composite": false
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "references": [
    {
      "path": "../../libs/auth/contracts"
    },
    {
      "path": "../../libs/history/contracts"
    },
    {
      "path": "../../libs/organisations/contracts"
    },
    {
      "path": "../../libs/projects/contracts"
    },
    {
      "path": "../../libs/shared/util"
    }
  ]
}
