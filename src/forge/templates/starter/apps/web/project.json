{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "projectType": "application",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/web" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --config apps/web/vitest.config.ts apps/web/src" }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": { "command": "playwright test --config apps/web/playwright.config.ts" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config apps/web/vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/web/tsconfig.json"
      }
    }
  },
  "tags": [
    "type:app-web",
    "scope:app"
  ],
  "sourceRoot": "apps/web/src"
}
