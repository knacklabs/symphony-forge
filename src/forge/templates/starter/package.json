{
  "name": "starter",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "prisma generate && nx run-many -t build --parallel=2",
    "start:prod": "node apps/api/dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -b apps/api/tsconfig.json && nx run-many -t typecheck --parallel=2",
    "test:api": "vitest run --config apps/api/vitest.config.ts",
    "test:hooks": "vitest run --config apps/web/vitest.config.ts",
    "test:browser": "playwright test --config apps/web/playwright.config.ts",
    "test": "corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test:api && corepack pnpm run test:hooks && corepack pnpm run test:browser",
    "test:stack": "node scripts/test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/config": "4.0.2",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.16.3",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "zod": "4.1.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4",
    "@tanstack/react-query": "5.90.5",
    "@tanstack/react-table": "8.21.3",
    "react-hook-form": "7.65.0",
    "@hookform/resolvers": "5.2.2",
    "radix-ui": "1.8.1",
    "cmdk": "1.1.1",
    "express": "5.2.1",
    "lucide-react": "0.548.0",
    "sonner": "2.0.7",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "class-variance-authority": "0.7.1"
  },
  "devDependencies": {
    "nx": "22.0.1",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "@vitejs/plugin-react": "5.0.4",
    "vitest": "3.2.4",
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "4.10.2",
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "27.0.1",
    "supertest": "7.1.4",
    "@types/supertest": "6.0.3",
    "@types/pg": "8.15.5",
    "@types/express": "5.0.3",
    "@types/cookie-parser": "1.4.9",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.1.16",
    "@tailwindcss/vite": "4.1.16",
    "tw-animate-css": "1.4.0",
    "shadcn": "4.21.4",
    "eslint": "9.38.0",
    "@eslint/js": "9.38.0",
    "typescript-eslint": "8.46.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "@nx/eslint-plugin": "22.0.1"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "playwright-core": "1.56.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "nx",
      "prisma"
    ]
  }
}
