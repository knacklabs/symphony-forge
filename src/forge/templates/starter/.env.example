DATABASE_URL=postgresql://postgres:local-password@localhost:5432/starter
# Optional for migration drift checks. Create this separate, disposable database first.
SHADOW_DATABASE_URL=postgresql://postgres:local-password@localhost:5432/starter_shadow
APP_ENV=development
LOG_LEVEL=info
APP_COMPANIES=many
PORT=3000
# Requests a minute from one address: to each sign-in, sign-up and other account route, and to each other route.
AUTH_RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_MINUTE=120
APP_ORIGIN=http://localhost:3000
# Only the setup:company command uses these credentials. Replace them before setup.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-long-password
