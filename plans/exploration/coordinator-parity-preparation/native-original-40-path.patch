+    prompt.write_text("Inspect docs/product/BRIEF.md; return one finding.")
+    code, out = run(repo, "forge.py", "explore", "--prompt-file", str(prompt),
+                    "--purpose", purpose, "--print-only",
+                    env={"FORGE_COORDINATOR": "codex",
+                         "PATH": str(tmp_path) + os.pathsep + os.environ["PATH"]})
+    assert code == 0, out
+    assert model in out and effort in out and "read-only" in out
+    assert "not launched" in out
+    assert not (load_factory_lib(repo).git_control_dir(repo) / "delegations.jsonl").exists()
