+    capture = tmp_path / "capture.json"
+    monkeypatch.setenv("FORGE_COORDINATOR", "codex")
+    monkeypatch.setenv("FAKE_CODEX_CAPTURE", str(capture))
+    monkeypatch.setenv("PATH", f"{executable.parent}{os.pathsep}{os.environ['PATH']}")
+    return capture
