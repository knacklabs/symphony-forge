+def test_supervised_cancel_retains_session_and_native_resume_finishes(
+        native_repo, tmp_path, monkeypatch):
+    from forge_cli.codex_status import cmd_cancel, cmd_resume
+    from forge_cli.delegate import launch_companion, load_delegations
+
+    executable = fake_codex(
+        tmp_path,
+        session_id="native-recovery-session",
+        wait_on_new=30,
+        completed_message="resumed",
+    )
+    native_env(monkeypatch, tmp_path, executable)
+    original = launch_companion(
+        native_repo,
+        task_id="explore-recovery",
+        text="wait for cancellation",
+        path=native_repo / ".factory" / "briefs" / "explore-recovery.md",
+        task_sha256_value="",
+        model="model-pin",
+        effort="high",
+        write=False,
+        background=True,
+    )
+    launch_id = original["launch_id"]
+    output = Path(original["output_path"])
+    deadline = time.monotonic() + 5
+    while time.monotonic() < deadline:
+        if output.is_file() and "native-recovery-session" in output.read_text():
+            break
+        time.sleep(0.05)
+    assert output.is_file() and "native-recovery-session" in output.read_text()
+
+    cmd_cancel(argparse.Namespace(repo=str(native_repo), id=launch_id))
+    rows = [row for row in load_delegations(native_repo)
+            if row["launch_id"] == launch_id]
+    terminals = [row for row in rows
+                 if row["launch_status"] in {"succeeded", "failed"}]
+    assert len(terminals) == 1
+    assert terminals[0]["launch_status"] == "failed"
+    assert terminals[0]["session_id"] == "native-recovery-session"
+
+    prompt = tmp_path / "resume.md"
+    prompt.write_text("finish now")
+    cmd_resume(argparse.Namespace(
+        repo=str(native_repo), id=launch_id,
+        prompt_file=str(prompt), background=False,
+    ))
+    resumed = load_delegations(native_repo)[-1]
+    assert resumed["launch_status"] == "succeeded"
+    assert resumed["resume_session"] == "native-recovery-session"
+    assert resumed["session_id"] == "native-recovery-session"
+    assert resumed["argv"][-3:] == [
+        "resume", "native-recovery-session", "-",
+    ]
