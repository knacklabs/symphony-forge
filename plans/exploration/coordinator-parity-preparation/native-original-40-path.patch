+from test_native_launch import fake_codex, native_env, native_repo  # noqa: F401
+
+
+def seed_launch(repo, **overrides):
+    lib = load_factory_lib(repo)
+    control = lib.git_control_dir(repo)
+    control.mkdir(parents=True, exist_ok=True)
+    output = control / "native-output.jsonl"
+    output.write_text('{"type":"thread.started","thread_id":"native-session"}\n')
+    row = {
+        "generated_by": "orchestrator", "at": "2026-01-01T00:00:00+00:00",
+        "launch_id": "launch-native-test", "task": "explore-test",
+        "brief_sha256": "test", "task_sha256": "", "write": False,
+        "model": "gpt-5.6-terra", "effort": "high", "transport": "native",
+        "argv": [], "argv_sha256": "test", "launch_status": "running",
+        "output_path": str(output), "process_token": "delegation-launch-native-test",
+        **overrides,
+    }
+    (control / "delegations.jsonl").write_text(json.dumps(row) + "\n")
+    return row
+
+
+def test_native_status_reports_protected_jobs_without_plugin(repo, tmp_path):
+    seed_launch(repo)
+    code, out = run(repo, "forge.py", "codex", "status",
+                    "--state-root", str(tmp_path / "no-plugin"))
+    assert code == 0, out
+    assert "launch-native-test" in out and "write=no" in out
+    assert "gpt-5.6-terra @ high" in out
+    assert "unknown" not in out and "log:" in out
+
+
+def test_native_status_ignores_logs_outside_protected_directory(repo, tmp_path):
+    external = tmp_path / "unrelated.jsonl"
+    external.write_text("unrelated")
+    seed_launch(repo, output_path=str(external))
+    code, out = run(repo, "forge.py", "codex", "status")
+    assert code == 0 and "launch-native-test" in out
+    assert str(external) not in out
+
