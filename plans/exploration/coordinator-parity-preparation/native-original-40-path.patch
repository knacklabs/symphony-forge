+"""Read-only exploration through the same protected launcher as other workers."""
+from __future__ import annotations
+
+import argparse
+import uuid
+from pathlib import Path
+
+from factory_lib import load_json, repo_root, run_state_path
+from .common import fail
+from .delegate import launch_companion, mode_run_config
+
+
+def read_prompt(path: str) -> str:
+    try:
+        text = Path(path).expanduser().read_text(encoding="utf-8")
+    except (OSError, UnicodeError) as exc:
+        fail(f"cannot read exploration prompt {path}: {exc}")
+    if not text.strip():
+        fail("exploration prompt must not be empty")
+    return text
+
+
+def cmd_explore(args: argparse.Namespace) -> None:
+    base = Path(args.repo).resolve() if args.repo else repo_root()
+    prompt = read_prompt(args.prompt_file)
+    model, effort, _ = mode_run_config(base, args.purpose)
+    identifier = f"explore-{uuid.uuid4().hex[:12]}"
+    text = (
+        "# Read-only exploration\n\n"
+        "Read only the code and references named below. Return findings with "
+        "file references. Do not edit files, record gate evidence, or start "
+        "implementation. Follow the relevant constitution references.\n\n"
+        + prompt
+    )
+    launch_companion(
+        base, task_id=identifier, text=text,
+        path=base / ".factory" / "diagnostic-briefs" / f"{identifier}.md",
+        task_sha256_value="", model=model, effort=effort, write=False,
+        story=load_json(run_state_path(base), default={}).get("issue_key", ""),
+        background=bool(args.background), print_only=bool(args.print_only),
+    )
