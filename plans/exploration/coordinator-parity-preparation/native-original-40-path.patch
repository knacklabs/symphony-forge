+            if operation != "Update" or moved or not path:
+                return None
+            paths.append(path)
+            moved = True
+            continue
+        if line == "*** End of File":
+            if operation != "Update":
+                return None
+            continue
+        if line.startswith("*** "):
+            return None
+    return paths if paths else None
