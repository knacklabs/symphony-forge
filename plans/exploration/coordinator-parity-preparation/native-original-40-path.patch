+        identity = psutil.Process(process.pid).create_time()
+        seed_launch(repo, pid=process.pid, pid_started=str(identity - 1))
+        code, out = run(repo, "forge.py", "codex", "cancel", "launch-native-test")
+        assert code != 0 and "reused" in out, out
+        assert process.poll() is None
+    finally:
