#!/bin/sh
# Generated by forge sync for Forge v1.2.7; forge sync rewrites it. It is never committed.
if [ -x "$0.pre-forge" ]; then
  input=$(mktemp) || exit 1
  cat > "$input"
  sh -c '. "$0.pre-forge"' "$0" "$@" < "$input" || { status=$?; rm -f "$input"; exit "$status"; }
  exec < "$input"
  rm -f "$input"
fi
command -v forge >/dev/null 2>&1 && exec forge hook pre-commit "$@"
echo "Forge isn't installed, so git can't check this commit." >&2
echo "Next: uv tool install git+https://github.com/knacklabs/symphony-forge@v1.2.7" >&2
exit 1
