# Project-local gstack (loaded by direnv; run `direnv allow` once per machine).
export GSTACK_HOME="$PWD/.gstack"

# The three phases verify.py runs. ONLY in the harness itself; client repos: set your own three
# commands below this block.
if [ ! -f constitution/VENDORED_FROM ]; then
  export FACTORY_STRUCTURAL_CMD="python3 factory/scripts/check_dual_runtime.py"
  export FACTORY_TYPECHECK_CMD="python3 factory/scripts/check_factory_scaffold.py"
  export FACTORY_TEST_CMD="uv run --with pytest python -m pytest factory/tests -q"
fi
export FACTORY_STRUCTURAL_CMD="npm run format:check && npm run check:architecture && npm run lint:changed"
export FACTORY_TYPECHECK_CMD="npm run typecheck"
export FACTORY_TEST_CMD="npm test"
