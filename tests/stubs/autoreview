#!/usr/bin/env python3
"""Stub Autoreview: answers each run from the queue in $AUTOREVIEW_STUB and records the call.

An answer is {"exit": <code>, "report": <the JSON it writes, or null>, "say": <its last line>};
the last answer repeats. With --codex-bin it starts that Codex the way the real helper does
(`exec -C <an empty folder>`), so a test can see which tree the reviewer reads.
"""
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

args = sys.argv[1:]
queue_file = Path(os.environ["AUTOREVIEW_STUB"])
queue = json.loads(queue_file.read_text("utf-8"))
answer = queue.pop(0) if len(queue) > 1 else queue[0]
queue_file.write_text(json.dumps(queue), "utf-8")
head = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
with open(queue_file.with_suffix(".calls.jsonl"), "a", encoding="utf-8") as calls:
    calls.write(json.dumps({"args": args, "head": head}) + "\n")
if "--codex-bin" in args:
    subprocess.run([args[args.index("--codex-bin") + 1], "exec", "-C", tempfile.mkdtemp(), "-"],
                   check=True)
if answer.get("report") is not None:
    Path(args[args.index("--json-output") + 1]).write_text(json.dumps(answer["report"]), "utf-8")
print(answer.get("say", "autoreview done"))
sys.exit(answer.get("exit", 0))
